def load_token():
    """
    Load GitLab token from .env file or TOKEN constant.
    
    Returns:
        Token string or None if not found
    """
    # Check if TOKEN constant is already set
    if TOKEN:
        return TOKEN
    
    # Try to load from .env file
    script_dir = os.path.dirname(os.path.abspath(__file__))
    env_file = os.path.join(script_dir, '.env')
    
    if os.path.exists(env_file):
        try:
            with open(env_file, 'r') as f:
                for line in f:
                    line = line.strip()
                    
                    # Skip comments and empty lines
                    if not line or line.startswith('#'):
                        continue
                    
                    # Look for token
                    if '=' in line:
                        key, value = line.split('=', 1)
                        key = key.strip()
                        value = value.strip()
                        
                        # Remove quotes if present
                        if (value.startswith('"') and value.endswith('"')) or \
                           (value.startswith("'") and value.endswith("'")):
                            value = value[1:-1]
                        
                        # Check for token keys
                        if key in ('GITLAB_TOKEN', 'TOKEN'):
                            log(f"Token loaded from .env file", "INFO")
                            return value
        except Exception as e:
            log(f"Error reading .env file: {e}", "WARN")
    
    return None


def validate_token(token, base_url):
    """
    Validate that the token works by making a test API call.
    Exits the script if token is invalid.
    
    Args:
        token: GitLab personal access token
        base_url: GitLab API base URL
    """
    log("Validating GitLab token...", "INFO")
    
    if not token:
        log("ERROR: No token found", "ERROR")
        log("Please provide a token via:", "ERROR")
        log("  1. .env file (add line: GITLAB_TOKEN=your_token_here)", "ERROR")
        log("  2. --token command line argument", "ERROR")
        log("  3. Edit TOKEN constant in the script", "ERROR")
        log("", "ERROR")
        log("Token must have 'api' and 'write_repository' permissions", "ERROR")
        log("Exiting safely - no changes made", "ERROR")
        sys.exit(1)
    
    # Test the token with a simple API call
    try:
        url = f"{base_url.rstrip('/')}/projects?per_page=1"
        req = urllib.request.Request(url, method="GET")
        req.add_header("PRIVATE-TOKEN", token)
        
        with urllib.request.urlopen(req, timeout=10) as response:
            if response.getcode() == 200:
                log("Token is valid", "INFO")
                log(f"Connected to GitLab: {base_url}", "INFO")
                return
    except urllib.error.HTTPError as e:
        if e.code == 401:
            log("ERROR: Token is invalid or expired", "ERROR")
        else:
            log(f"ERROR: HTTP {e.code} - {e.reason}", "ERROR")
    except Exception as e:
        log(f"ERROR: Could not connect to GitLab: {e}", "ERROR")
    
    log("", "ERROR")
    log("Token validation failed", "ERROR")
    log("Please ensure your token:", "ERROR")
    log("  - Is not expired", "ERROR")
    log("  - Has 'api' permission", "ERROR")
    log("  - Has 'write_repository' permission", "ERROR")
    log("Exiting safely - no changes made", "ERROR")
    sys.exit(1)


