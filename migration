def process_project(pid, show_full_diff=True, skip_mr=False, choices=None):
    """
    Process a single project: update files, create MR, manage tags.
    
    Args:
        pid: Project ID
        show_full_diff: Show full diff vs summary
        skip_mr: Skip merge request creation
        choices: List of file choices ('1'=POM, '2'=CI, '3'=EB)
    """
    log("="*70, "INFO")
    
    # Get project info
    project_info = api_call(f"projects/{pid}")
    project_name = project_info.get('name', f"ID:{pid}") if isinstance(project_info, dict) else f"ID:{pid}"
    log(f"Processing: {project_name} (ID: {pid})", "INFO")
    log("="*70, "INFO")
    
    # Check if feature branch exists
    branch_check = api_call(f"projects/{pid}/repository/branches/{urllib.parse.quote(FEATURE_BRANCH, safe='')}")
    current_ref = FEATURE_BRANCH if isinstance(branch_check, dict) and "name" in branch_check else SOURCE_BRANCH
    
    log(f"Working on branch: {current_ref}", "INFO")
    
    # Collect file changes
    actions = []
    
    # 1. Update POM file
    if choices and '1' in choices:
        log("Fetching pom.xml...", "INFO")
        response = api_call(f"projects/{pid}/repository/files/{urllib.parse.quote('pom.xml', safe='')}?ref={urllib.parse.quote(current_ref, safe='')}")
        
        if isinstance(response, dict) and response.get("error"):
            log(f"Could not fetch pom.xml: {response.get('details')}", "ERROR")
        elif "content" in response:
            original = base64.b64decode(response['content']).decode('utf-8')
            
            # Update Java version
            updated = re.sub(
                r"<(java\.version|maven\.compiler\.(source|target|release))>11</\1>",
                r"<\1>17</\1>",
                original
            )
            
            # Update parent POM
            if "<parent>" in updated:
                updated = re.sub(
                    r"<parent>[\s\S]*?</parent>",
                    update_parent_block,
                    updated
                )
            
            if original != updated:
                actions.append({
                    "action": "update",
                    "file_path": "pom.xml",
                    "content": updated,
                    "old_content": original
                })
    
    # 2. Update CI file
    if choices and '2' in choices:
        log("Fetching .gitlab-ci.yml...", "INFO")
        response = api_call(f"projects/{pid}/repository/files/{urllib.parse.quote('.gitlab-ci.yml', safe='')}?ref={urllib.parse.quote(current_ref, safe='')}")
        
        if isinstance(response, dict) and response.get("error"):
            log(f"Could not fetch .gitlab-ci.yml: {response.get('details')}", "ERROR")
        elif "content" in response:
            original = base64.b64decode(response['content']).decode('utf-8')
            
            # Remove image lines
            updated = re.sub(r"^\s*image:.*(\n|$)", "", original, flags=re.MULTILINE)
            
            if original != updated:
                actions.append({
                    "action": "update",
                    "file_path": ".gitlab-ci.yml",
                    "content": updated,
                    "old_content": original
                })
    
    # 3. Update Elastic Beanstalk config
    if choices and '3' in choices:
        log("Fetching .elasticbeanstalk/config.yml...", "INFO")
        file_path = ".elasticbeanstalk/config.yml"
        response = api_call(f"projects/{pid}/repository/files/{urllib.parse.quote(file_path, safe='')}?ref={urllib.parse.quote(current_ref, safe='')}")
        
        if isinstance(response, dict) and response.get("error"):
            log(f"Could not fetch {file_path}: {response.get('details')}", "ERROR")
        elif "content" in response:
            original = base64.b64decode(response['content']).decode('utf-8')
            
            # Update platform
            updated = re.sub(
                r"(default_platform:\s*).*$",
                f"default_platform: {NEW_DEFAULT_PLATFORM}",
                original,
                flags=re.MULTILINE
            )
            
            if original != updated:
                actions.append({
                    "action": "update",
                    "file_path": file_path,
                    "content": updated,
                    "old_content": original
                })
    
    # Show changes and ask for confirmation
    if not actions:
        log("No changes needed for this project", "INFO")
    else:
        print("\nProposed changes:")
        for action in actions:
            show_diff(action['file_path'], action['old_content'], action['content'], show_full_diff)
        
        print("\nOptions:")
        print("  y - Commit these changes")
        print("  n - Skip this project")
        print("  0 - Exit script")
        
        response = input("\nProceed with commit? [y/n/0]: ").strip().lower()
        
        if response == '0':
            safe_exit("User chose to exit")
        
        if response != 'y':
            log("Skipping this project", "INFO")
            return
        
        # Create feature branch if needed
        if current_ref != FEATURE_BRANCH:
            log(f"Creating feature branch {FEATURE_BRANCH}...", "INFO")
            api_call(
                f"projects/{pid}/repository/branches",
                "POST",
                {"branch": FEATURE_BRANCH, "ref": SOURCE_BRANCH}
            )
            current_ref = FEATURE_BRANCH
        
        # Prepare commit actions
        commit_actions = []
        for action in actions:
            commit_actions.append({
                "action": "update",
                "file_path": action['file_path'],
                "content": action['content']
            })
        
        # Commit changes
        commit_payload = {
            "branch": FEATURE_BRANCH,
            "commit_message": f"fix: {UPGRADE_TYPE}",
            "actions": commit_actions
        }
        
        log("Committing changes...", "INFO")
        commit_response = api_call(f"projects/{pid}/repository/commits", "POST", commit_payload)
        
        if isinstance(commit_response, dict) and not commit_response.get("error"):
            commit_sha = commit_response.get("id") or (commit_response.get("commit") or {}).get("id")
            log(f"Commit created: {commit_sha[:8] if commit_sha else 'unknown'}", "INFO")
        else:
            log(f"Commit failed: {commit_response.get('details', 'unknown error')}", "ERROR")
    
    # Create merge request
    if not skip_mr:
        log("Checking for existing merge requests...", "INFO")
        existing_mrs = api_call(f"projects/{pid}/merge_requests?state=opened&source_branch={urllib.parse.quote(FEATURE_BRANCH, safe='')}")
        
        has_mr = isinstance(existing_mrs, list) and len(existing_mrs) > 0
        
        if has_mr:
            mr_url = existing_mrs[0].get('web_url', 'unknown')
            log(f"Merge request already exists: {mr_url}", "INFO")
        else:
            if prompt_yes_no(f"Create merge request for {project_name}?", default=True):
                mr_payload = {
                    "source_branch": FEATURE_BRANCH,
                    "target_branch": SOURCE_BRANCH,
                    "title": MR_TITLE
                }
                
                log("Creating merge request...", "INFO")
                mr_response = api_call(f"projects/{pid}/merge_requests", "POST", mr_payload)
                
                if isinstance(mr_response, dict) and not mr_response.get("error"):
                    mr_url = mr_response.get('web_url', 'unknown')
                    log(f"Merge request created: {mr_url}", "INFO")
                else:
                    log(f"MR creation failed: {mr_response.get('details', 'unknown error')}", "ERROR")
    
    # Tag and deployment management
    print("\nOptions:")
    print("  y - Manage tags and deployments")
    print("  n - Skip tag management")
    print("  0 - Exit script")
    
    response = input("\nManage tags and deployments? [y/n/0]: ").strip().lower()
    
    if response == '0':
        safe_exit("User chose to exit")
    
    if response != 'y':
        log(f"Completed {project_name}", "INFO")
        return
    
    # Fetch and filter tags
    log("Fetching project tags...", "INFO")
    all_tags = fetch_tags_for_project(pid)
    
    if isinstance(all_tags, dict) and all_tags.get("error"):
        log(f"Could not fetch tags: {all_tags.get('details')}", "ERROR")
        return
    
    tag_filter = filter_deployment_tags(all_tags)
    
    if isinstance(tag_filter, dict) and tag_filter.get("error"):
        log(f"Error filtering tags: {tag_filter.get('details')}", "ERROR")
        return
    
    deployment_tags = tag_filter['sorted_tags']
    found_categories = tag_filter['found_categories']
    missing_categories = tag_filter['missing_categories']
    
    # Show available tags
    log("Deployment tags found:", "INFO")
    if found_categories:
        for category, tag_names in found_categories.items():
            log(f"  {category.upper()}: {', '.join(tag_names)}", "INFO")
    
    if missing_categories:
        for category in missing_categories:
            log(f"  {category.upper()}: NOT FOUND", "WARN")
    
    if not deployment_tags:
        log("No deployment tags found", "WARN")
        return
    
    # Process each deployment tag sequentially
    for idx, tag in enumerate(deployment_tags):
        tag_name = tag.get('name')
        tag_commit = (tag.get('commit') or {}).get('id')
        
        print("\n" + "="*70)
        print(f"Tag: {tag_name}")
        if tag.get('protected'):
            print("Status: PROTECTED (cannot be modified)")
        print("="*70)
        
        if tag.get('protected'):
            log(f"Tag '{tag_name}' is protected. Skipping.", "WARN")
            continue
        
        print("\nOptions:")
        print(f"  y - Delete and recreate '{tag_name}' tag, then deploy")
        print(f"  n - Skip this tag")
        print(f"  0 - Exit script")
        
        response = input(f"\nProcess tag '{tag_name}'? [y/n/0]: ").strip().lower()
        
        if response == '0':
            safe_exit("User chose to exit")
        
        if response != 'y':
            log(f"Skipping tag '{tag_name}'", "INFO")
            continue
        
        # Delete existing tag
        log(f"Deleting tag '{tag_name}'...", "INFO")
        delete_response = api_call(
            f"projects/{pid}/repository/tags/{urllib.parse.quote(tag_name, safe='')}",
            method="DELETE"
        )
        
        if isinstance(delete_response, dict) and delete_response.get("error"):
            log(f"Could not delete tag: {delete_response.get('details')}", "ERROR")
            continue
        
        # Create new tag
        log(f"Creating tag '{tag_name}' on {FEATURE_BRANCH}...", "INFO")
        create_response = api_call(
            f"projects/{pid}/repository/tags",
            "POST",
            {"tag_name": tag_name, "ref": FEATURE_BRANCH}
        )
        
        if isinstance(create_response, dict) and create_response.get("error"):
            log(f"Could not create tag: {create_response.get('details')}", "ERROR")
            continue
        
        new_tag_commit = (create_response.get('commit') or {}).get('id')
        log(f"Tag '{tag_name}' created successfully", "INFO")
        
        # Ask about deployment
        if not prompt_yes_no(f"Deploy tag '{tag_name}'?", default=True):
            log(f"Skipping deployment for '{tag_name}'", "INFO")
            continue
        
        # Deploy the tag
        deploy_success = deploy_tag(pid, tag_name, new_tag_commit)
        
        if deploy_success:
            log(f"Successfully deployed tag '{tag_name}'", "INFO")
        else:
            log(f"Deployment failed for tag '{tag_name}'", "ERROR")
            
            # Ask if they want to continue to next tag
            if idx < len(deployment_tags) - 1:
                if not prompt_yes_no("Deployment failed. Continue to next tag?", default=False):
                    log("Stopping tag processing", "INFO")
                    break
    
    log(f"Completed processing {project_name}", "INFO")


# ============================================================================
# MAIN ENTRY POINT
# ============================================================================

def main():
    """
    Main entry point for the script.
    """
    global TOKEN, PROJECT_IDS, BASE_URL
    
    # Parse command line arguments
    parser = argparse.ArgumentParser(
        description="GitLab Java 11 to Java 17 migration helper script"
    )
    parser.add_argument(
        "--projects",
        help="Comma-separated project IDs (e.g., 101,102,103)",
        default=""
    )
    parser.add_argument(
        "--token",
        help="GitLab personal access token",
        default=""
    )
    parser.add_argument(
        "--base-url",
        help="GitLab API base URL",
        default=""
    )
    parser.add_argument(
        "--full-diff",
        help="Show full diffs (default: True)",
        action="store_true",
        default=True
    )
    parser.add_argument(
        "--summary-only",
        help="Show only line count summary",
        action="store_true"
    )
    parser.add_argument(
        "--skip-mr",
        help="Skip merge request creation",
        action="store_true"
    )
    parser.add_argument(
        "--log-dir",
        help="Directory for log files",
        default="migration_logs"
    )
    
    args = parser.parse_args()
    
    # Setup logging
    log_file = setup_logging(args.log_dir)
    log("="*70, "INFO")
    log("GitLab Java Migration Script", "INFO")
    log("="*70, "INFO")
    log(f"Log file: {log_file}", "INFO")
    log("", "INFO")
    
    # Load configuration
    if args.base_url:
        BASE_URL = args.base_url.strip().rstrip('/')
        log(f"Using BASE_URL from command line", "INFO")
    elif not BASE_URL:
        # Try to load from .env
        script_dir = os.path.dirname(os.path.abspath(__file__))
        env_file = os.path.join(script_dir, '.env')
        if os.path.exists(env_file):
            with open(env_file, 'r') as f:
                for line in f:
                    line = line.strip()
                    if not line or line.startswith('#'):
                        continue
                    if '=' in line:
                        key, value = line.split('=', 1)
                        key = key.strip()
                        value = value.strip().strip('"').strip("'")
                        if key in ('BASE_URL', 'GITLAB_BASE_URL', 'GITLAB_URL'):
                            BASE_URL = value.rstrip('/')
                            log(f"Using BASE_URL from .env file", "INFO")
                            break
    
    if not BASE_URL:
        log("ERROR: BASE_URL not configured", "ERROR")
        log("Please set BASE_URL via:", "ERROR")
        log("  1. --base-url command line argument", "ERROR")
        log("  2. .env file (add line: BASE_URL=https://gitlab.company.com/api/v4)", "ERROR")
        log("  3. Edit BASE_URL constant in the script", "ERROR")
        sys.exit(1)
    
    log(f"GitLab API: {BASE_URL}", "INFO")
    log("", "INFO")
    
    # Load and validate token
    if args.token:
        TOKEN = args.token.strip()
        log("Using token from command line", "INFO")
    else:
        TOKEN = load_token()
    
    validate_token(TOKEN, BASE_URL)
    log("", "INFO")
    
    # Get project IDs
    if args.projects:
        try:
            PROJECT_IDS = [int(x.strip()) for x in args.projects.split(",") if x.strip()]
        except ValueError:
            log("ERROR: Invalid project IDs. Use comma-separated integers.", "ERROR")
            sys.exit(1)
    
    if not PROJECT_IDS:
        log("ERROR: No project IDs specified", "ERROR")
        log("Please provide project IDs via:", "ERROR")
        log("  1. --projects command line argument (e.g., --projects 101,102,103)", "ERROR")
        log("  2. Edit PROJECT_IDS constant in the script", "ERROR")
        sys.exit(1)
    
    log(f"Projects to process: {PROJECT_IDS}", "INFO")
    log("", "INFO")
    
    # Determine diff display mode
    show_full_diff = args.full_diff and not args.summary_only
    
    # Ask user which files to update
    print("Which files would you like to update?")
    print("  1 - POM files (Java version and parent POM)")
    print("  2 - GitLab CI configuration")
    print("  3 - Elastic Beanstalk configuration")
    print("  4 - All of the above")
    print("  0 - Exit")
    print()
    
    choice = input("Enter your choices (e.g., '1,2' or '4'): ").strip()
    
    if choice == '0':
        safe_exit("User chose to exit")
    
    # Parse choices
    choices = [c.strip() for c in choice.split(',') if c.strip()]
    
    # Handle "all" option
    if '4' in choices:
        choices = ['1', '2', '3']
    
    if not choices:
        log("No files selected", "WARN")
        safe_exit("No work to do")
    
    log(f"Selected updates: {', '.join(['POM' if c=='1' else 'CI' if c=='2' else 'EB' if c=='3' else c for c in choices])}", "INFO")
    log("", "INFO")
    
    # Process each project
    for project_id in PROJECT_IDS:
        try:
            process_project(
                project_id,
                show_full_diff=show_full_diff,
                skip_mr=args.skip_mr,
                choices=choices
            )
            print()
        except KeyboardInterrupt:
            log("", "INFO")
            safe_exit("Interrupted by user (Ctrl+C)")
        except Exception as e:
            log(f"Unexpected error processing project {project_id}: {e}", "ERROR")
            
            if not prompt_yes_no("Continue to next project?", default=True):
                safe_exit("User chose to exit after error")
    
    # Final summary
    log("="*70, "INFO")
    log("Migration Complete", "INFO")
    log("="*70, "INFO")
    log(f"Processed {len(PROJECT_IDS)} project(s)", "INFO")
    log(f"Log file: {log_file}", "INFO")
    log("", "INFO")


if __name__ == "__main__":
    main()
