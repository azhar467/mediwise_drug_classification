def retry(tries=3, delay=1, backoff=2):
    """
    Decorator to retry failed API calls.
    Useful for handling transient network errors.
    """
    def decorator(func):
        @wraps(func)
        def wrapper(*args, **kwargs):
            _tries, _delay = tries, delay
            while True:
                try:
                    return func(*args, **kwargs)
                except Exception as e:
                    _tries -= 1
                    if _tries <= 0:
                        raise
                    log(f"Transient error: {e}. Retrying in {_delay}s... ({_tries} attempts left)", "WARN")
                    time.sleep(_delay)
                    _delay *= backoff
        return wrapper
    return decorator


@retry(tries=3, delay=1, backoff=2)
def api_call(endpoint, method="GET", data=None):
    """
    Make a GitLab API call.
    
    Args:
        endpoint: API endpoint (without base URL)
        method: HTTP method (GET, POST, DELETE)
        data: Request payload for POST/PUT requests
    
    Returns:
        Parsed JSON response or error dict
    """
    url = f"{BASE_URL.rstrip('/')}/{endpoint.lstrip('/')}"
    
    if not TOKEN:
        raise RuntimeError("API token not set")
    
    body = json.dumps(data).encode("utf-8") if data else None
    req = urllib.request.Request(url, method=method, data=body)
    req.add_header("PRIVATE-TOKEN", TOKEN)
    req.add_header("Content-Type", "application/json")
    
    try:
        with urllib.request.urlopen(req, data=body, timeout=30) as response:
            text = response.read().decode("utf-8")
            if not text:
                return {}
            return json.loads(text)
    except urllib.error.HTTPError as e:
        return {"error": True, "details": f"HTTP {e.code}: {e.reason}"}
    except Exception as e:
        return {"error": True, "details": str(e)}


