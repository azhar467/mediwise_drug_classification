def update_parent_block(match):
    """
    Update parent POM version in a regex match.
    """
    block = match.group(0)
    # Update version tag
    block = re.sub(r"<version>.*?</version>", 
                   f"<version>{TARGET_PARENT_VERSION}</version>", 
                   block)
    # Update relativePath
    block = re.sub(r"(parent-pom-).*?(\.xml)", 
                   lambda m: m.group(1) + TARGET_PARENT_VERSION + m.group(2), 
                   block)
    return block


def show_diff(file_path, old_content, new_content, show_full=True):
    """
    Display a diff between old and new content.
    
    Args:
        file_path: Name of the file
        old_content: Original content
        new_content: New content
        show_full: If True, show full unified diff; if False, show summary
    """
    if show_full:
        old_lines = old_content.splitlines(keepends=True)
        new_lines = new_content.splitlines(keepends=True)
        diff = ''.join(difflib.unified_diff(
            old_lines, new_lines, 
            fromfile=file_path, 
            tofile=f"{file_path} (new)", 
            lineterm=''
        ))
        if diff.strip():
            print(f"\n--- Diff for {file_path} ---")
            print(diff)
            print(f"--- End diff for {file_path} ---\n")
        else:
            print(f"   {file_path} -> No textual changes")
    else:
        # Show summary only
        diff_lines = list(difflib.ndiff(
            old_content.splitlines(), 
            new_content.splitlines()
        ))
        added = len([l for l in diff_lines if l.startswith('+ ')])
        removed = len([l for l in diff_lines if l.startswith('- ')])
        print(f"   {file_path} -> [+{added} | -{removed} lines]")


def prompt_yes_no(prompt_text, default=True):
    """
    Prompt user for yes/no input.
    
    Args:
        prompt_text: Question to ask
        default: Default value if user just presses Enter
    
    Returns:
        True for yes, False for no
    """
    options = "[Y/n]" if default else "[y/N]"
    try:
        answer = input(f"{prompt_text} {options}: ").strip().lower()
    except EOFError:
        return default
    
    if answer == '':
        return default
    
    return answer in ("y", "yes")


