import urllib.request, json, base64, re, urllib.parse, datetime, time, difflib

# --- CONFIGURATION ---
BASE_URL = "https://gitlab.company-domain.com/api/v4" 
TOKEN = "glpat-your-token-here" 
PROJECT_IDS = [101, 102] # Add all 12 Project IDs here

JIRA_ID = "4323"
UPGRADE_TYPE = "java17-migration"
FEATURE_BRANCH = f"task-{JIRA_ID}-{UPGRADE_TYPE}"
SOURCE_BRANCH = "develop"
MR_TITLE = f"TASK-{JIRA_ID}: java migration"

TARGET_PARENT_VERSION = "1.8.3"
# Latest recommended platform as of Feb 2026
NEW_DEFAULT_PLATFORM = "arn:aws:elasticbeanstalk:us-east-1::platform/Corretto 17 running on 64bit Amazon Linux 2/3.10.3"

TAG_MAPPING = {
    "1": "dev",
    "2": "azure-dev",
    "3": "test",
    "4": "azure-test"
}

# ---------------------------------------------------------

def log(msg, level="INFO"):
    timestamp = datetime.datetime.now().strftime("%H:%M:%S")
    print(f"[{timestamp}] [{level}] {msg}")

def api_call(endpoint, method="GET", data=None):
    url = f"{BASE_URL}/{endpoint}"
    req = urllib.request.Request(url, method=method)
    req.add_header("PRIVATE-TOKEN", TOKEN)
    req.add_header("Content-Type", "application/json")
    body = json.dumps(data).encode("utf-8") if data else None
    try:
        with urllib.request.urlopen(req, data=body) as response:
            return json.loads(response.read().decode("utf-8"))
    except Exception as e:
        return {"error": True, "details": str(e)}

def update_parent_block(match):
    block = match.group(0)
    block = re.sub(r"<version>.*?</version>", f"<version>{TARGET_PARENT_VERSION}</version>", block)
    block = re.sub(r"(parent-pom-).*?(\.xml)", rf"\1{TARGET_PARENT_VERSION}\2", block)
    return block

def main():
    if not PROJECT_IDS: return log("Please add PROJECT_IDS.", "ERROR")
    
    choices = input("Select Updates (1:POM, 2:CI, 3:EB): ").replace(" ", "").split(',')
    do_orch = input("Trigger Tags/Deployment? (y/n): ").lower() == 'y'

    for pid in PROJECT_IDS:
        project_info = api_call(f"projects/{pid}")
        p_name = project_info.get('name', f"ID:{pid}")
        log(f"--- Processing: {p_name} ---")
        
        actions = []
        br_check = api_call(f"projects/{pid}/repository/branches/{FEATURE_BRANCH}")
        current_ref = FEATURE_BRANCH if "name" in br_check else SOURCE_BRANCH
        
        # --- 1. POM Update (11 to 17 Swap) ---
        if '1' in choices:
            res = api_call(f"projects/{pid}/repository/files/pom.xml?ref={current_ref}")
            if "content" in res:
                orig = base64.b64decode(res['content']).decode('utf-8')
                upd = re.sub(r"<(java\.version|maven\.compiler\.(source|target|release))>11</\1>", r"<\1>17</\1>", orig)
                if "<parent>" in upd:
                    upd = re.sub(r"<parent>[\s\S]*?</parent>", update_parent_block, upd)
                if orig != upd:
                    actions.append({"action": "update", "file_path": "pom.xml", "content": upd, "old_content": orig})

        # --- 2. CI image cleanup ---
        if '2' in choices:
            res = api_call(f"projects/{pid}/repository/files/.gitlab-ci.yml?ref={current_ref}")
            if "content" in res:
                orig = base64.b64decode(res['content']).decode('utf-8')
                upd = re.sub(r"^\s*image:.*(\n|$)", "", orig, flags=re.MULTILINE)
                if orig != upd:
                    actions.append({"action": "update", "file_path": ".gitlab-ci.yml", "content": upd, "old_content": orig})

        # --- 3. EB Config platform update ---
        if '3' in choices:
            path = urllib.parse.quote(".elasticbeanstalk/config.yml", safe='')
            res = api_call(f"projects/{pid}/repository/files/{path}?ref={current_ref}")
            if "content" in res:
                orig = base64.b64decode(res['content']).decode('utf-8')
                upd = re.sub(r"(default_platform:\s*).*$", f"default_platform: {NEW_DEFAULT_PLATFORM}", orig, flags=re.MULTILINE)
                if orig != upd:
                    actions.append({"action": "update", "file_path": ".elasticbeanstalk/config.yml", "content": upd, "old_content": orig})

        # --- PRE-COMMIT DIFF SUMMARY ---
        if actions:
            print(f"📊 Proposed Changes for {p_name}:")
            for action in actions:
                diff = list(difflib.ndiff(action['old_content'].splitlines(), action['content'].splitlines()))
                added = len([l for l in diff if l.startswith('+ ')])
                removed = len([l for l in diff if l.startswith('- ')])
                print(f"   📄 {action['file_path']} -> [+{added} | -{removed} lines]")

            if input(f"👉 Commit and raise MR for {p_name}? (y/n): ").lower() == 'y':
                if "name" not in br_check:
                    api_call(f"projects/{pid}/repository/branches", "POST", {"branch": FEATURE_BRANCH, "ref": SOURCE_BRANCH})
                
                api_call(f"projects/{pid}/repository/commits", "POST", {
                    "branch": FEATURE_BRANCH, "commit_message": f"fix: {UPGRADE_TYPE}", "actions": actions
                })

                existing = api_call(f"projects/{pid}/merge_requests?state=opened&source_branch={FEATURE_BRANCH}")
                if not existing or len(existing) == 0:
                    api_call(f"projects/{pid}/merge_requests", "POST", {
                        "source_branch": FEATURE_BRANCH, "target_branch": SOURCE_BRANCH, 
                        "title": MR_TITLE
                    })
                    log(f"   ✅ MR raised successfully.")
                else:
                    log(f"   ℹ️ MR already exists: {existing[0]['web_url']}")

        # --- TAG ORCHESTRATION ---
        if do_orch:
            print("\n🏷️ Tags: 1:dev, 2:azure-dev, 3:test, 4:azure-test")
            tag_choices = input(f"Select tags for {p_name} (e.g., 1,2): ").replace(" ", "").split(',')
            selected_tags = [TAG_MAPPING[t] for t in tag_choices if t in TAG_MAPPING]
            
            for tag in selected_tags:
                exists = api_call(f"projects/{pid}/repository/tags/{tag}")
                if not exists.get("error"):
                    api_call(f"projects/{pid}/repository/tags/{tag}", method="DELETE")
                
                t_res = api_call(f"projects/{pid}/repository/tags", "POST", {"tag_name": tag, "ref": FEATURE_BRANCH})
                if not t_res.get("error"):
                    log(f"   🚀 Created tag '{tag}' on {FEATURE_BRANCH}")

    log("🏁 Batch processing complete.")

if __name__ == "__main__":
    main()
