def fetch_tags_for_project(pid):
    """
    Fetch all tags for a project.
    
    Args:
        pid: Project ID
    
    Returns:
        List of tag objects or error dict
    """
    page = 1
    all_tags = []
    
    while True:
        endpoint = f"projects/{pid}/repository/tags?per_page=100&page={page}"
        response = api_call(endpoint)
        
        if isinstance(response, dict) and response.get("error"):
            return response
        
        if not response:
            break
        
        all_tags.extend(response if isinstance(response, list) else [])
        
        if len(response) < 100:
            break
        
        page += 1
    
    return all_tags


def filter_deployment_tags(tags):
    """
    Filter tags to only deployment-related tags (dev, test, performance).
    Returns tags sorted in deployment order.
    
    Args:
        tags: List of all tags
    
    Returns:
        Dict with sorted_tags, found_categories, missing_categories
    """
    if isinstance(tags, dict) and tags.get("error"):
        return {"error": True, "details": tags.get("details")}
    
    tag_list = tags if isinstance(tags, list) else []
    
    # Define deployment order
    categories = {
        'dev': {'priority': 1, 'variants': ['dev', 'azure-dev'], 'found': []},
        'test': {'priority': 2, 'variants': ['test', 'azure-test'], 'found': []},
        'performance': {'priority': 3, 'variants': ['performance', 'azure-performance'], 'found': []}
    }
    
    # Categorize tags
    for tag in tag_list:
        if not isinstance(tag, dict):
            continue
        tag_name = tag.get('name', '').lower()
        
        for category, info in categories.items():
            if tag_name in info['variants']:
                info['found'].append(tag)
                break
    
    # Build sorted list
    sorted_tags = []
    found_categories = {}
    missing_categories = []
    
    for category, info in sorted(categories.items(), key=lambda x: x[1]['priority']):
        if info['found']:
            sorted_tags.extend(info['found'])
            found_categories[category] = [t.get('name') for t in info['found']]
        else:
            missing_categories.append(category)
    
    return {
        'sorted_tags': sorted_tags,
        'found_categories': found_categories,
        'missing_categories': missing_categories
    }


def get_pipeline_for_commit(pid, commit_sha):
    """
    Get the pipeline for a specific commit.
    
    Args:
        pid: Project ID
        commit_sha: Commit SHA
    
    Returns:
        Pipeline object or None
    """
    try:
        pipelines = api_call(f"projects/{pid}/pipelines?sha={commit_sha}&per_page=1")
        if isinstance(pipelines, list) and len(pipelines) > 0:
            return pipelines[0]
        return None
    except Exception as e:
        log(f"Error fetching pipeline: {e}", "ERROR")
        return None


def wait_for_pipeline(pid, pipeline_id, timeout=1800, check_interval=30):
    """
    Wait for a pipeline to complete.
    
    Args:
        pid: Project ID
        pipeline_id: Pipeline ID
        timeout: Maximum wait time in seconds
        check_interval: How often to check status
    
    Returns:
        Dict with status and pipeline object
    """
    log(f"Waiting for pipeline {pipeline_id} to complete...", "INFO")
    
    start_time = time.time()
    last_status = None
    
    while True:
        elapsed = time.time() - start_time
        if elapsed > timeout:
            log(f"Pipeline timed out after {int(elapsed)}s", "ERROR")
            return {"status": "timeout", "pipeline": None}
        
        try:
            pipeline = api_call(f"projects/{pid}/pipelines/{pipeline_id}")
            if isinstance(pipeline, dict) and not pipeline.get("error"):
                status = pipeline.get('status', 'unknown')
                
                if status != last_status:
                    log(f"Pipeline status: {status}", "INFO")
                    last_status = status
                
                if status in ['success', 'failed', 'canceled', 'skipped']:
                    return {"status": status, "pipeline": pipeline}
                
                time.sleep(check_interval)
            else:
                time.sleep(check_interval)
        except Exception as e:
            log(f"Error checking pipeline: {e}", "WARN")
            time.sleep(check_interval)


def get_pipeline_jobs(pid, pipeline_id):
    """
    Get all jobs for a pipeline.
    
    Args:
        pid: Project ID
        pipeline_id: Pipeline ID
    
    Returns:
        List of job objects
    """
    try:
        jobs = api_call(f"projects/{pid}/pipelines/{pipeline_id}/jobs?per_page=100")
        return jobs if isinstance(jobs, list) else []
    except Exception as e:
        log(f"Error fetching jobs: {e}", "ERROR")
        return []


def find_job_by_name(jobs, job_name):
    """
    Find a specific job by name.
    
    Args:
        jobs: List of job objects
        job_name: Name to search for
    
    Returns:
        Job object or None
    """
    for job in jobs:
        if isinstance(job, dict) and job.get('name') == job_name:
            return job
    return None


def trigger_job(pid, job_id):
    """
    Trigger a manual job.
    
    Args:
        pid: Project ID
        job_id: Job ID
    
    Returns:
        Response dict
    """
    try:
        return api_call(f"projects/{pid}/jobs/{job_id}/play", method="POST")
    except Exception as e:
        log(f"Error triggering job: {e}", "ERROR")
        return {"error": True, "details": str(e)}


def wait_for_job(pid, job_id, timeout=900, check_interval=15):
    """
    Wait for a job to complete.
    
    Args:
        pid: Project ID
        job_id: Job ID
        timeout: Maximum wait time in seconds
        check_interval: How often to check status
    
    Returns:
        Dict with status and job object
    """
    log(f"Waiting for job {job_id} to complete...", "INFO")
    
    start_time = time.time()
    last_status = None
    
    while True:
        elapsed = time.time() - start_time
        if elapsed > timeout:
            log(f"Job timed out after {int(elapsed)}s", "ERROR")
            return {"status": "timeout", "job": None}
        
        try:
            job = api_call(f"projects/{pid}/jobs/{job_id}")
            if isinstance(job, dict) and not job.get("error"):
                status = job.get('status', 'unknown')
                
                if status != last_status:
                    job_name = job.get('name', 'unknown')
                    log(f"Job '{job_name}' status: {status}", "INFO")
                    last_status = status
                
                if status in ['success', 'failed', 'canceled', 'skipped']:
                    return {"status": status, "job": job}
                
                time.sleep(check_interval)
            else:
                time.sleep(check_interval)
        except Exception as e:
            log(f"Error checking job: {e}", "WARN")
            time.sleep(check_interval)


def map_tag_to_deploy_job(tag_name):
    """
    Map a tag name to its corresponding deploy job.
    
    Args:
        tag_name: Tag name (e.g., 'dev', 'azure-test')
    
    Returns:
        Deploy job name or None
    """
    tag_lower = tag_name.lower().replace('azure-', '')
    
    job_map = {
        'dev': 'eb-deploy-dev-azure',
        'test': 'eb-deploy-test-azure',
        'performance': 'eb-deploy-performance-azure'
    }
    
    return job_map.get(tag_lower)


def deploy_tag(pid, tag_name, tag_commit):
    """
    Deploy a tag by waiting for build and triggering deployment jobs.
    
    Args:
        pid: Project ID
        tag_name: Name of the tag
        tag_commit: Commit SHA for the tag
    
    Returns:
        True if deployment succeeded, False otherwise
    """
    log(f"Starting deployment for tag '{tag_name}'...", "INFO")
    
    # Wait for pipeline to be created
    log("Waiting 10 seconds for pipeline to be triggered...", "INFO")
    time.sleep(10)
    
    # Get pipeline
    pipeline = get_pipeline_for_commit(pid, tag_commit)
    if not pipeline:
        log("No pipeline found. Deployment aborted.", "ERROR")
        return False
    
    pipeline_id = pipeline.get('id')
    pipeline_url = pipeline.get('web_url', 'N/A')
    log(f"Found pipeline {pipeline_id}: {pipeline_url}", "INFO")
    
    # Wait for build to complete
    result = wait_for_pipeline(pid, pipeline_id, timeout=1800)
    
    if result['status'] != 'success':
        log(f"Build {result['status']}. Deployment aborted.", "ERROR")
        return False
    
    log("Build succeeded! Proceeding to deployment...", "INFO")
    
    # Get pipeline jobs
    jobs = get_pipeline_jobs(pid, pipeline_id)
    if not jobs:
        log("No jobs found in pipeline. Deployment aborted.", "WARN")
        return False
    
    # Trigger eb-terminate job
    terminate_job = find_job_by_name(jobs, 'eb-terminate')
    if terminate_job:
        terminate_job_id = terminate_job.get('id')
        terminate_status = terminate_job.get('status')
        
        log(f"Found 'eb-terminate' job (status: {terminate_status})", "INFO")
        
        if terminate_status == 'manual':
            log("Triggering 'eb-terminate' job...", "INFO")
            trigger_result = trigger_job(pid, terminate_job_id)
            
            if not isinstance(trigger_result, dict) or not trigger_result.get('error'):
                terminate_result = wait_for_job(pid, terminate_job_id, timeout=900)
                
                if terminate_result['status'] != 'success':
                    log(f"eb-terminate job {terminate_result['status']}. Deployment aborted.", "ERROR")
                    return False
                
                log("eb-terminate completed successfully", "INFO")
        else:
            log(f"eb-terminate is not manual (status: {terminate_status})", "WARN")
    else:
        log("'eb-terminate' job not found. Skipping termination step.", "WARN")
    
    # Trigger deployment job
    deploy_job_name = map_tag_to_deploy_job(tag_name)
    if not deploy_job_name:
        log(f"No deployment job mapping for tag '{tag_name}'. Deployment aborted.", "ERROR")
        return False
    
    # Refresh jobs list
    jobs = get_pipeline_jobs(pid, pipeline_id)
    deploy_job = find_job_by_name(jobs, deploy_job_name)
    
    if not deploy_job:
        log(f"'{deploy_job_name}' job not found. Deployment aborted.", "ERROR")
        return False
    
    deploy_job_id = deploy_job.get('id')
    deploy_status = deploy_job.get('status')
    
    log(f"Found '{deploy_job_name}' job (status: {deploy_status})", "INFO")
    
    if deploy_status == 'manual':
        log(f"Triggering '{deploy_job_name}' job...", "INFO")
        trigger_result = trigger_job(pid, deploy_job_id)
        
        if not isinstance(trigger_result, dict) or not trigger_result.get('error'):
            deploy_result = wait_for_job(pid, deploy_job_id, timeout=1200)
            
            if deploy_result['status'] == 'success':
                log(f"Deployment completed successfully for tag '{tag_name}'", "INFO")
                return True
            else:
                log(f"Deployment {deploy_result['status']} for tag '{tag_name}'", "ERROR")
                return False
    else:
        log(f"{deploy_job_name} is not manual (status: {deploy_status})", "WARN")
        return False


